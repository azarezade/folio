{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Folio",
  "version": "0.1.0",
  "identifier": "app.folio.desktop",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Folio",
        "width": 1280,
        "height": 860,
        "minWidth": 720,
        "minHeight": 520,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' folio: blob: data:; media-src 'self' blob: data:; connect-src 'self' folio: ipc: http://ipc.localhost; worker-src 'self' blob:; frame-src 'self' blob:; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline' blob:; font-src 'self' data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Productivity",
    "copyright": "GPL-3.0-or-later. Notebook decoding ports kfxlib by John Howell (GPLv3).",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-",
      "dmg": {
        "windowSize": {
          "width": 560,
          "height": 340
        },
        "appPosition": {
          "x": 150,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 410,
          "y": 170
        }
      }
    },
    "resources": {
      "THIRD_PARTY_NOTICES.txt": "THIRD_PARTY_NOTICES.txt",
      "../../LICENSE": "LICENSE"
    },
    "homepage": "https://github.com/azarezade/folio",
    "shortDescription": "Read, export and sync your Kindle Scribe notebooks and books."
  }
}
